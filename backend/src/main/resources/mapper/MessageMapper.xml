<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjx.travel.mapper.MessageMapper">

    <resultMap id="messageMap" type="com.zjx.travel.domain.MessageEntity">
        <result column="id" property="id" />
        <result column="title" property="title" />
        <result column="content" property="content" />
        <result column="type" property="type" />
        <result column="is_read" property="isRead" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <association property="userId" javaType="com.zjx.travel.domain.TravelUserEntity">
            <result column="id_2" property="id" />
            <result column="account_2" property="account" />
            <result column="password_2" property="password" />
            <result column="nickname_2" property="nickname" />
            <result column="phone_2" property="phone" />
            <result column="avatar_2" property="avatar" />
            <result column="user_role_2" property="userRole" />
            <result column="status_2" property="status" />
            <result column="create_time_2" property="createTime" />
            <result column="update_time_2" property="updateTime" />
        </association>
    </resultMap>

    <sql id="baseSql">
        SELECT
            message.id, message.title, message.content, message.type, message.is_read, message.create_time, message.update_time,
            travel_user_2.id id_2, travel_user_2.account account_2, travel_user_2.password password_2, travel_user_2.nickname nickname_2, travel_user_2.phone phone_2, travel_user_2.avatar avatar_2, travel_user_2.user_role user_role_2, travel_user_2.status status_2, travel_user_2.create_time create_time_2, travel_user_2.update_time update_time_2
        FROM message
             JOIN travel_user travel_user_2 ON(message.user_id = travel_user_2.id)
        WHERE message.del_mark = 1
    </sql>

    <sql id="condition">
        <if test="message.id != null">
             and message.id = #{message.id}
        </if>
        <if test="message.userId != null and message.userId.id != null">
             and travel_user_2.id = #{message.userId.id}
        </if>
        <if test="message.userIdNe != null">
             and travel_user_2.id != #{message.userIdNe}
        </if>
        <if test="message.title != null and message.title != ''">
             and message.title LIKE concat('%', #{message.title}, '%')
        </if>
        <if test="message.content != null and message.content != ''">
             and message.content LIKE concat('%', #{message.content}, '%')
        </if>
        <if test="message.type != null">
             and message.type = #{message.type}
        </if>
        <if test="message.typeNe != null">
             and message.type != #{message.typeNe}
        </if>
        <if test="message.isRead != null">
             and message.is_read = #{message.isRead}
        </if>
        <if test="message.createTime != null and message.createTime != ''">
             and message.create_time LIKE concat('%', #{message.createTime}, '%')
        </if>
        <if test="message.keyword != null and message.keyword != ''">
            and (
                message.title LIKE concat('%', #{message.keyword}, '%')
                or travel_user_2.nickname LIKE concat('%', #{message.keyword}, '%')
                or travel_user_2.account LIKE concat('%', #{message.keyword}, '%')
            )
        </if>
    </sql>

    <select id="queryById" resultMap="messageMap">
        <include refid="baseSql"></include>
        AND message.id = #{id}
    </select>

    <select id="queryAllByLimit" resultMap="messageMap">
        <include refid="baseSql"></include>
        <include refid="condition"></include>
        order by id asc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1)
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into message(user_id, title, content, type, is_read, create_time, update_time)
        values(#{userId.id}, #{title}, #{content}, #{type}, #{isRead}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        update message
        <set>
            <if test="userId != null and userId.id != null">
                user_id = #{userId.id},
            </if>
            <if test="title != null and title != ''">
                title = #{title},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="isRead != null">
                is_read = #{isRead},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE message SET del_mark = 0 WHERE id = #{id}
    </update>

    <!-- 标记已读：按 id 或 ids 批量 -->
    <update id="markRead">
        update message
        set is_read = 1, update_time = now()
        where del_mark = 1
          and user_id = #{userId}
          and (
          <choose>
              <when test="id != null">
                  id = #{id}
              </when>
              <when test="ids != null and ids.size() > 0">
                  id in
                  <foreach collection="ids" item="i" open="(" separator="," close=")">
                      #{i}
                  </foreach>
              </when>
              <otherwise>1 = 0</otherwise>
          </choose>
          )
    </update>

    <!-- 未读消息数量 -->
    <select id="unreadCount" resultType="java.lang.Long">
        select count(1) from message where del_mark = 1 and user_id = #{userId} and is_read = 0
    </select>
</mapper>
