<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjx.travel.mapper.ScenicOrdersMapper">

    <resultMap id="scenicOrdersMap" type="com.zjx.travel.domain.ScenicOrdersEntity">
        <result column="id" property="id" />
        <result column="order_no" property="orderNo" />
        <result column="contact_name" property="contactName" />
        <result column="contact_phone" property="contactPhone" />
        <result column="play_date" property="playDate" />
        <result column="ticket_count" property="ticketCount" />
        <result column="total_amount" property="totalAmount" />
        <result column="pay_type" property="payType" />
        <result column="pay_status" property="payStatus" />
        <result column="status" property="status" />
        <result column="cancel_time" property="cancelTime" />
        <result column="cancel_reason" property="cancelReason" />
        <result column="unit_price" property="unitPrice" />
        <result column="ticket_type_id" property="ticketTypeId" />
        <result column="stock_reserved" property="stockReserved" />
        <result column="create_time" property="createTime" />
        <result column="pay_time" property="payTime" />
        <association property="userId" javaType="com.zjx.travel.domain.TravelUserEntity">
            <result column="id_2" property="id" />
            <result column="account_2" property="account" />
            <result column="password_2" property="password" />
            <result column="nickname_2" property="nickname" />
            <result column="phone_2" property="phone" />
            <result column="avatar_2" property="avatar" />
            <result column="user_role_2" property="userRole" />
            <result column="status_2" property="status" />
            <result column="create_time_2" property="createTime" />
            <result column="update_time_2" property="updateTime" />
        </association>
        <association property="scenicId" javaType="com.zjx.travel.domain.ScenicEntity">
            <result column="id_3" property="id" />
            <result column="name_3" property="name" />
            <result column="cover_3" property="cover" />
            <result column="images_3" property="images" />
            <result column="price_3" property="price" />
            <result column="open_time_3" property="openTime" />
            <result column="address_3" property="address" />
            <result column="longitude_3" property="longitude" />
            <result column="latitude_3" property="latitude" />
            <result column="intro_3" property="intro" />
            <result column="score_3" property="score" />
            <result column="view_count_3" property="viewCount" />
            <result column="status_3" property="status" />
            <result column="create_time_3" property="createTime" />
            <result column="update_time_3" property="updateTime" />
            <association property="categoryId" javaType="com.zjx.travel.domain.ScenicCategoryEntity">
                <result column="id_5" property="id" />
                <result column="name_5" property="name" />
                <result column="create_time_5" property="createTime" />
            </association>
        </association>
    </resultMap>

    <sql id="baseSql">
        SELECT
            scenic_orders.id, scenic_orders.order_no, scenic_orders.contact_name, scenic_orders.contact_phone, scenic_orders.play_date, scenic_orders.ticket_count, scenic_orders.total_amount, scenic_orders.pay_type, scenic_orders.pay_status, scenic_orders.status, scenic_orders.cancel_time, scenic_orders.cancel_reason, scenic_orders.unit_price, scenic_orders.ticket_type_id, scenic_orders.stock_reserved, scenic_orders.create_time, scenic_orders.pay_time,
            travel_user_2.id id_2, travel_user_2.account account_2, travel_user_2.password password_2, travel_user_2.nickname nickname_2, travel_user_2.phone phone_2, travel_user_2.avatar avatar_2, travel_user_2.user_role user_role_2, travel_user_2.status status_2, travel_user_2.create_time create_time_2, travel_user_2.update_time update_time_2, 
            scenic_2.id id_3, scenic_2.name name_3, scenic_2.cover cover_3, scenic_2.images images_3, scenic_2.price price_3, scenic_2.open_time open_time_3, scenic_2.address address_3, scenic_2.longitude longitude_3, scenic_2.latitude latitude_3, scenic_2.intro intro_3, scenic_2.score score_3, scenic_2.view_count view_count_3, scenic_2.status status_3, scenic_2.create_time create_time_3, scenic_2.update_time update_time_3,
            scenic_category_5.id id_5, scenic_category_5.name name_5, scenic_category_5.create_time create_time_5
        FROM scenic_orders
             JOIN travel_user travel_user_2 ON(scenic_orders.user_id = travel_user_2.id)
             JOIN scenic scenic_2 ON(scenic_orders.scenic_id = scenic_2.id)
             JOIN scenic_category scenic_category_5 ON(scenic_2.category_id = scenic_category_5.id)
        WHERE scenic_orders.del_mark = 1 
    </sql>

    <sql id="condition">
        <if test="scenicOrders.id != null">
             and scenic_orders.id = #{scenicOrders.id}
        </if>
        <if test="scenicOrders.orderNo != null and scenicOrders.orderNo != ''">
             and scenic_orders.order_no LIKE concat('%', #{scenicOrders.orderNo}, '%')
        </if>
        <!-- 按下单人过滤：前端"我的订单"依赖这个条件；缺失会导致任何人都能查到全部订单 -->
        <if test="scenicOrders.userId != null and scenicOrders.userId.id != null">
             and scenic_orders.user_id = #{scenicOrders.userId.id}
        </if>
        <if test="scenicOrders.keyword != null and scenicOrders.keyword != ''">
            and (
                travel_user_2.nickname LIKE concat('%', #{scenicOrders.keyword}, '%')
                or scenic_2.name LIKE concat('%', #{scenicOrders.keyword}, '%')
            )
        </if>
        <if test="scenicOrders.scenicId != null">
            <if test="scenicOrders.scenicId.id != null">
                 and scenic_2.id = #{scenicOrders.scenicId.id}
            </if>
            <if test="scenicOrders.scenicId.categoryId != null">
                <if test="scenicOrders.scenicId.categoryId.id != null">
                     and scenic_category_5.id = #{scenicOrders.scenicId.categoryId.id}
                </if>
                <if test="scenicOrders.scenicId.categoryId.name != null and scenicOrders.scenicId.categoryId.name != ''">
                     and scenic_category_5.name LIKE concat('%', #{scenicOrders.scenicId.categoryId.name}, '%')
                </if>
                <if test="scenicOrders.scenicId.categoryId.createTime != null and scenicOrders.scenicId.categoryId.createTime != ''">
                     and scenic_category_5.create_time LIKE concat('%', #{scenicOrders.scenicId.categoryId.createTime}, '%')
                </if>
            </if>
            <if test="scenicOrders.scenicId.name != null and scenicOrders.scenicId.name != ''">
                 and scenic_2.name LIKE concat('%', #{scenicOrders.scenicId.name}, '%')
            </if>
            <if test="scenicOrders.scenicId.cover != null and scenicOrders.scenicId.cover != ''">
                 and scenic_2.cover LIKE concat('%', #{scenicOrders.scenicId.cover}, '%')
            </if>
            <if test="scenicOrders.scenicId.images != null and scenicOrders.scenicId.images != ''">
                 and scenic_2.images LIKE concat('%', #{scenicOrders.scenicId.images}, '%')
            </if>
            <if test="scenicOrders.scenicId.price != null">
                 and scenic_2.price = #{scenicOrders.scenicId.price}
            </if>
            <if test="scenicOrders.scenicId.openTime != null and scenicOrders.scenicId.openTime != ''">
                 and scenic_2.open_time LIKE concat('%', #{scenicOrders.scenicId.openTime}, '%')
            </if>
            <if test="scenicOrders.scenicId.address != null and scenicOrders.scenicId.address != ''">
                 and scenic_2.address LIKE concat('%', #{scenicOrders.scenicId.address}, '%')
            </if>
            <if test="scenicOrders.scenicId.longitude != null">
                 and scenic_2.longitude = #{scenicOrders.scenicId.longitude}
            </if>
            <if test="scenicOrders.scenicId.latitude != null">
                 and scenic_2.latitude = #{scenicOrders.scenicId.latitude}
            </if>
            <if test="scenicOrders.scenicId.intro != null and scenicOrders.scenicId.intro != ''">
                 and scenic_2.intro LIKE concat('%', #{scenicOrders.scenicId.intro}, '%')
            </if>
            <if test="scenicOrders.scenicId.score != null">
                 and scenic_2.score = #{scenicOrders.scenicId.score}
            </if>
            <if test="scenicOrders.scenicId.viewCount != null">
                 and scenic_2.view_count = #{scenicOrders.scenicId.viewCount}
            </if>
            <if test="scenicOrders.scenicId.status != null">
                 and scenic_2.status = #{scenicOrders.scenicId.status}
            </if>
            <if test="scenicOrders.scenicId.createTime != null and scenicOrders.scenicId.createTime != ''">
                 and scenic_2.create_time LIKE concat('%', #{scenicOrders.scenicId.createTime}, '%')
            </if>
            <if test="scenicOrders.scenicId.updateTime != null and scenicOrders.scenicId.updateTime != ''">
                 and scenic_2.update_time LIKE concat('%', #{scenicOrders.scenicId.updateTime}, '%')
            </if>
        </if>
        <if test="scenicOrders.contactName != null and scenicOrders.contactName != ''">
             and scenic_orders.contact_name LIKE concat('%', #{scenicOrders.contactName}, '%')
        </if>
        <if test="scenicOrders.contactPhone != null and scenicOrders.contactPhone != ''">
             and scenic_orders.contact_phone LIKE concat('%', #{scenicOrders.contactPhone}, '%')
        </if>
        <if test="scenicOrders.playDate != null and scenicOrders.playDate != ''">
             and scenic_orders.play_date LIKE concat('%', #{scenicOrders.playDate}, '%')
        </if>
        <if test="scenicOrders.ticketCount != null">
             and scenic_orders.ticket_count = #{scenicOrders.ticketCount}
        </if>
        <if test="scenicOrders.totalAmount != null">
             and scenic_orders.total_amount = #{scenicOrders.totalAmount}
        </if>
        <if test="scenicOrders.payType != null">
             and scenic_orders.pay_type = #{scenicOrders.payType}
        </if>
        <if test="scenicOrders.payStatus != null">
             and scenic_orders.pay_status = #{scenicOrders.payStatus}
        </if>
        <if test="scenicOrders.status != null">
             and scenic_orders.status = #{scenicOrders.status}
        </if>
        <if test="scenicOrders.createTime != null and scenicOrders.createTime != ''">
             and scenic_orders.create_time LIKE concat('%', #{scenicOrders.createTime}, '%')
        </if>
        <if test="scenicOrders.payTime != null and scenicOrders.payTime != ''">
             and scenic_orders.pay_time LIKE concat('%', #{scenicOrders.payTime}, '%')
        </if>
    </sql>

    <select id="queryById" resultMap="scenicOrdersMap">
        <include refid="baseSql"></include>
        AND scenic_orders.id = #{id}
    </select>

    <select id="queryAllByLimit" resultMap="scenicOrdersMap">
        <include refid="baseSql"></include>
        <include refid="condition"></include>
        order by scenic_orders.id desc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1)
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <select id="statusStats" resultType="java.util.HashMap">
        select
            count(1) as total,
            sum(case when status = 1 then 1 else 0 end) as paidCount,
            sum(case when status = 0 then 1 else 0 end) as unpaidCount
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into scenic_orders(order_no, user_id, scenic_id, contact_name, contact_phone, play_date, ticket_count, total_amount, unit_price, ticket_type_id, stock_reserved, pay_type, pay_status, status, create_time, pay_time)
        values(#{orderNo}, #{userId.id}, #{scenicId.id}, #{contactName}, #{contactPhone}, #{playDate}, #{ticketCount}, #{totalAmount}, #{unitPrice}, #{ticketTypeId}, #{stockReserved}, #{payType}, #{payStatus}, #{status}, #{createTime}, #{payTime})
    </insert>

    <update id="deleteById">
        UPDATE scenic_orders SET del_mark = 0 WHERE id = #{id} AND del_mark = 1 AND status != 0
    </update>
    <update id="updateContact">
        UPDATE scenic_orders SET contact_name=#{contactName}, contact_phone=#{contactPhone}
        WHERE id=#{id} AND user_id=#{userId} AND del_mark=1 AND status=0
    </update>
    <update id="transitionToCancelled">
        UPDATE scenic_orders SET status=2, cancel_time=NOW(), cancel_reason=#{reason}
        WHERE id=#{id} AND status=0 AND del_mark=1 AND stock_reserved=1
    </update>
    <update id="transitionToTimeout">
        UPDATE scenic_orders SET status=2, cancel_time=NOW(), cancel_reason='TIMEOUT'
        WHERE id=#{id} AND status=0 AND del_mark=1 AND stock_reserved=1 AND create_time &lt;= DATE_SUB(NOW(), INTERVAL 30 MINUTE)
    </update>
    <update id="transitionToPaid">
        UPDATE scenic_orders SET status=1, pay_status=1, pay_time=NOW()
        WHERE id=#{id} AND user_id=#{userId} AND status=0 AND del_mark=1 AND create_time &gt; DATE_SUB(NOW(), INTERVAL 30 MINUTE)
    </update>
    <select id="findTimeoutOrders" resultMap="scenicOrdersMap">
        <include refid="baseSql"/> AND scenic_orders.status=0 AND scenic_orders.stock_reserved=1
        AND scenic_orders.create_time &lt;= DATE_SUB(NOW(), INTERVAL 30 MINUTE)
        AND scenic_orders.id &gt; #{afterId}
        ORDER BY scenic_orders.id LIMIT #{limit}
    </select>
</mapper>

