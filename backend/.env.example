# 复制本文件为 .env，填入真实 Key 后重启应用。
# .env 已被 .gitignore 忽略，不会进仓库；本文件（.env.example）需要提交。
# Key 申请地址：https://platform.deepseek.com/api_keys

# DeepSeek API Key（必填），形如 sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-在这里填你的key

# 可选：想换模型或中转地址时取消注释（不改就用 application.yml 里的默认值）
# SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
# SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-chat
