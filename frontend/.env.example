# 复制本文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略）

# 后端 API 基地址（含上下文路径，末尾不用带斜杠；生产环境可填完整域名）
VITE_API_BASE_URL=http://localhost:8081/travel

# 上传图片等静态资源基地址（只填域名/源，不要带上下文路径；生产环境可留空走同源）
VITE_ASSET_BASE_URL=http://localhost:8081

# 高德地图 Web端(JS API) Key（lbs.amap.com 控制台创建）
VITE_AMAP_KEY=

# 高德安全密钥 securityJsCode（与 Key 配套）
VITE_AMAP_SECURITY_CODE=
